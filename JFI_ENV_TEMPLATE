# Copy this file to .env and fill in your own values.
# See README.md -> "Configuration (.env)" for the full explanation of each setting.

# --- Required ---------------------------------------------------------------

# Base URL of any OpenAI-compatible chat API.
# Examples: http://127.0.0.1:11434/v1 (Ollama), http://127.0.0.1:8080/v1 (llama.cpp),
#           http://127.0.0.1:8000/v1 (vLLM), https://api.openai.com/v1
OPENAI_URL=http://127.0.0.1:11434/v1

# API key for that server. Local servers usually accept any non-empty string.
OPENAI_API_KEY=ollama

# Model name as the server expects it, e.g. qwen3:8b, gemma-4:31b, qwen3.5:35b-a3b
MODEL=qwen3:8b

# --- Optional: talk to Claude's own API instead of an OpenAI-compatible one --
#
# Set LLM_BACKEND=anthropic (or "claude") to bypass OPENAI_URL/OPENAI_API_KEY
# entirely and talk to Claude's native Messages API via ANTHROPIC_API_KEY
# instead (needs `uv sync --extra anthropic`). MODEL becomes a Claude model
# id, e.g. claude-sonnet-5. See README.md -> "Configuration (.env)" for the
# full picker of OPENAI_URL/MODEL/OPENAI_API_KEY per backend (Ollama,
# llama.cpp, vLLM, OpenAI, Claude).
# LLM_BACKEND=anthropic
# ANTHROPIC_API_KEY=sk-ant-your-real-key

# --- Optional ----------------------------------------------------------------

# Which SessionManager drives a session: "adaptive" (default) detects the
# task type (python/javascript/story) from the goal and sends smaller,
# type-specific planning rules instead of one generic block for every goal;
# "simple" opts back into the original one-size-fits-all rules.
# SESSION_MANAGER=adaptive

# Sampling temperature. Defaults to 0.7 if unset.
# TEMPERATURE=0.7

# Penalizes tokens proportional to how often they've already appeared in
# the response so far -- the standard lever against a model falling into a
# verbatim repetition loop (seen in practice on smaller/quantized models).
# 0.0 (OpenAI's own default, a no-op) if unset. Try 0.3-0.5 if a model gets
# stuck repeating itself; stronger models generally don't need it.
# FREQUENCY_PENALTY=0.0

# Context window of the served model, in tokens. History is compressed once a
# request would exceed CONTEXT_SIZE * CONTEXT_COMPRESSION_RATIO. Size it to
# what fits on your machine: 4096-16384 for an ~8GB setup with a small model,
# 32768+ for 27B/31B runs. Defaults to 32768 if unset.
# CONTEXT_SIZE=32768

# Headroom left for the model's own reply when deciding whether to compress
# history. Defaults to 0.7 if unset.
# CONTEXT_COMPRESSION_RATIO=0.7

# Max tokens (estimated) for a single streamed response before it's
# abandoned as a runaway generation and retried as a fresh turn. Defaults
# to 10000 if unset.
# STREAM_OUTPUT_CAP=10000

# Max tokens (estimated) of reasoning_content alone -- before any real
# content or tool call has started -- before that turn is abandoned and
# retried, same as STREAM_OUTPUT_CAP but on a much tighter budget. Some
# models can burn thousands of tokens per turn re-deliberating a decision
# they already made ("wait, actually...") without ever tripping
# STREAM_OUTPUT_CAP's larger limit, since they do eventually act -- this
# catches that earlier. Defaults to 3000 if unset.
# REASONING_OUTPUT_CAP=3000

# Seconds to wait on a single LLM request (connect + read) before giving up
# and offering Retry/Stop, instead of hanging with no feedback. Matters most
# after idling: a local server that unloaded its model, or a dead localhost
# socket, otherwise looks indistinguishable from a genuine freeze for a long
# time. Raise it if your server is legitimately this slow to start
# responding (e.g. a big model with cold prompt-eval on first token).
# Defaults to 120 if unset.
# LLM_REQUEST_TIMEOUT=120

# Live-console color preset. Leave unset (or "auto") to detect your terminal's
# background automatically. See README.md -> "Themes" for the full list (20
# presets) or how to supply your own colors as inline JSON.
# THEME=dark-ocean

# --- Optional: a different model/endpoint per phase --------------------------
#
# Each of OPENAI_URL / OPENAI_API_KEY / MODEL / TEMPERATURE / FREQUENCY_PENALTY
# / CONTEXT_SIZE can be overridden per phase by prefixing it PLANNER_, IMP_,
# TESTING_, or REVIEWER_. Any phase
# left unset falls back to the shared settings above, so uncomment only the
# phases (and only the settings within them) you actually want to route
# elsewhere — e.g. a cheap/fast model for testing, a stronger one for review.
# CONTEXT_SIZE in particular is worth setting per phase whenever a phase's
# model differs from the shared default's real context window — otherwise
# compression budgets that phase against the WRONG window (risking silent
# truncation on a smaller one, or needless over-compression on a larger one).

# PLANNER_MODEL=qwen3:8b
# PLANNER_OPENAI_URL=http://127.0.0.1:11434/v1
# PLANNER_OPENAI_API_KEY=ollama
# PLANNER_TEMPERATURE=0.7
# PLANNER_CONTEXT_SIZE=32768

# IMP_MODEL=qwen3:8b
# IMP_OPENAI_URL=http://127.0.0.1:11434/v1
# IMP_OPENAI_API_KEY=ollama
# IMP_TEMPERATURE=0.7
# IMP_CONTEXT_SIZE=32768

# TESTING_MODEL=qwen3:8b
# TESTING_OPENAI_URL=http://127.0.0.1:11434/v1
# TESTING_OPENAI_API_KEY=ollama
# TESTING_TEMPERATURE=0.7
# TESTING_CONTEXT_SIZE=32768

# REVIEWER_MODEL=gpt-4.1
# REVIEWER_OPENAI_URL=https://api.openai.com/v1
# REVIEWER_OPENAI_API_KEY=sk-your-real-key
# REVIEWER_TEMPERATURE=0.3
# REVIEWER_CONTEXT_SIZE=128000

# --- Debugging -----------------------------------------------------------

# The planner phase runs as 3 internal passes by default -- Architect (top-
# level shape only) -> Team Lead (feature breakdown) -> Journeyman (walks
# every branch down to genuinely atomic, checkbox-ready leaves) -- instead
# of one combined pass, because a single pass was observed letting compound
# leaves through (a "leaf" that was really several independent test cases,
# or several independent shell actions, bundled into one). Set this to opt
# back into the original one-pass planner (cheaper: 1 LLM call instead of 3
# for the whole phase) if you'd rather trade that decomposition quality for
# lower planner cost. Accepts 1/true/yes/on.
# PLANNER_SINGLE_PASS=1

# Every execute_command call runs immediately, with no approval prompt at
# all -- as if "Yes, for the rest of this session" had been answered every
# time, without anything needing to be there to answer it. Meant for
# unattended runs (CI, a scripted end-to-end test) where nothing can respond
# to an interactive prompt. Off by default -- approvals exist precisely
# because execute_command can do anything a shell command can, so only turn
# this on for a run you already trust completely. Accepts 1/true/yes/on.
# AUTO_APPROVE_COMMANDS=1

# Prints every message sent to the LLM each turn, in full -- no truncation
# anywhere, unlike the normal tool-result preview. Verbose by design; meant
# for prompt-engineering and context-compression debugging, not everyday
# runs. Accepts 1/true/yes/on.
# SHOW_STREAM_PROMPTS=1

# Appends every LLM request/response pair this run makes to
# JFI/<session>/llm_debug.jsonl -- one JSON object per line, full request
# (messages + tools) and full response (content + tool_calls), no
# truncation. Unlike SHOW_STREAM_PROMPTS (console/TUI-only, meant for
# watching a run live), this persists to disk so a run can be inspected
# afterward. Off by default since it writes on every single turn. Accepts
# 1/true/yes/on.
# LOG_LLM_CALL_DEBUG=1

# --- Optional: web dashboard (jfi-web) ---------------------------------------

# Mirrors this session's live status to JFI/<session>/web_status.json and
# accepts approval answers from JFI/<session>/web_answer.json, so the
# `jfi-web` dashboard (pip install "just-finish-it[web]") can show live
# progress and answer approval prompts from a browser instead of (or
# alongside) the terminal. Off by default. Accepts 1/true/yes/on.
# JFI_WEB_BRIDGE=1

# Pauses at a failed-review boundary for an explicit Approve/Reject (from the
# terminal, or from jfi-web if JFI_WEB_BRIDGE is also set) instead of
# automatically starting another fix iteration. Off by default -- this
# project's whole premise is finishing autonomously, so leave this unset
# unless you specifically want a human checkpoint there. Accepts 1/true/yes/on.
# REVIEW_LOOP_APPROVAL=1

# Port the jfi-web dashboard listens on. Defaults to 7777 if unset (not
# Streamlit's own default of 8501). Ignored if you pass --server.port
# yourself on the jfi-web command line.
# JFI_WEB_PORT=7777

# --- Optional: fleet dashboard (jfi-master) -----------------------------

# Reports this session's live status to a "master" fleet dashboard
# (`jfi-master`, pip install "just-finish-it[master]") over a WebSocket --
# e.g. ws://203.0.113.5:8765/report. Unlike JFI_WEB_BRIDGE (file-based,
# local-dashboard-only), the master can run on a completely different
# machine from this session: the two only ever talk over this one socket,
# never a shared filesystem. Independent of JFI_WEB_BRIDGE -- both can be
# on at once. Off by default. See src/JFI/web/master_server.py.
#
# SECURITY: jfi-master ships with no authentication -- anyone who can reach
# its port can see every reporting session's live status. Only point this
# at a master on a network you already trust (a VPN, a firewalled LAN),
# same trust model execute_command already has.
# MASTER_WS_URL=ws://203.0.113.5:8765/report

# --- Advanced ------------------------------------------------------------

# Where the JFI/ session folder is created, relative to. Defaults to the
# current working directory ("."); most people never need to set this.
# SESSION_PATH=.

# FlareSolverr endpoint the model falls back to (via execute_command/curl)
# when a site's anti-bot/DoS protection (Cloudflare challenge, etc.) blocks a
# direct curl request. Unset means no fallback is available -- the model is
# just told the request was blocked. See https://github.com/FlareSolverr/FlareSolverr
# FLARESOLVERR_URL=http://localhost:8192/
